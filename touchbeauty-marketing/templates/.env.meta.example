# --- Meta (Facebook + Instagram) Graph API keys ---
# Append these to WP_ImgUpload\.env alongside the existing WP_URL/WP_USERNAME/WP_APP_PASSWORD.
# NEVER commit real tokens. See META_SETUP_GUIDE.md for how to obtain each value.

META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=

# Facebook Page
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Instagram Business account (linked to the Page). Token can be the same Page token.
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=

# Default timezone for interpreting schedule_time in the CSV (IANA name).
META_TZ=Asia/Singapore
