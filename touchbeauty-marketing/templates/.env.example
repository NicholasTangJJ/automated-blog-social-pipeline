# Copy this file to .env (same folder the scripts run from) and fill in real values.
# NEVER commit .env. The scripts read these via python-dotenv.

# --- WordPress (upload_images.py, upload_post.py, meta_publish.py hosting) ---
WP_URL=https://www.touchbeauty.com.sg/wp-json/wp/v2
WP_USERNAME=your_wp_user
WP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx_xxxx_xxxx

# --- Meta / Instagram (meta_publish.py, PROTOCOL 4) ---
# See docs/META_SETUP_GUIDE.md for how to obtain these.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
